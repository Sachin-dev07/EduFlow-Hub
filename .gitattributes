# Auto detect text files and perform LF normalization
* text=auto

# Documents
*.md text
*.txt text

# Source code
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.css text
*.scss text
*.html text

# Scripts
*.sh text eol=lf
*.bat text eol=crlf

# Configuration files
.gitignore text
.gitattributes text
.env.example text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
